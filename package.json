{
  "name": "jetpack-compose-learning",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.4",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
